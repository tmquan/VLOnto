    rdfs:label "Law"@en,
        "Luật"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf vlo:NormativeLegalDocument ;
    skos:definition "A statute adopted by the National Assembly."@en,
        "Văn bản luật do Quốc hội thông qua."@vi ;
    vlo:module vlo:module-documents ;
    vlo:typeConcept vlo:doctype-law .

vlo:doctype-law a owl:NamedIndividual,
        vlo:DocumentType ;
    skos:definition "Document type of laws adopted by the National Assembly."@en ;
    skos:inScheme vlo:DocumentTypeScheme ;
    skos:notation "L" ;
    skos:prefLabel "Law"@en,
        "Luật"@vi ;
    skos:topConceptOf vlo:DocumentTypeScheme .

vlarea:bo-may-hanh-chinh a vlo:LegalArea ;
    rdfs:label "Administrative apparatus"@en,
        "Bộ máy hành chính"@vi ;
    skos:inScheme vlo:LegalAreaScheme,
        vlo:TermAreaScheme ;
    skos:prefLabel "Administrative apparatus"@en,
        "Bộ máy hành chính"@vi .

vlo:Resolution a owl:Class ;
    rdfs:label "Resolution"@en,
        "Nghị quyết"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf vlo:NormativeLegalDocument ;
    skos:definition "A normative resolution issued by a collegial body such as the National Assembly, its Standing Committee, the Government or the Council of Judges of the Supreme People's Court."@en,
        "Nghị quyết quy phạm pháp luật do cơ quan tập thể ban hành, như Quốc hội, Ủy ban Thường vụ Quốc hội, Chính phủ hoặc Hội đồng Thẩm phán Tòa án nhân dân tối cao."@vi ;
    vlo:module vlo:module-documents ;
    vlo:typeConcept vlo:doctype-resolution .

vlo:doctype-resolution a owl:NamedIndividual,
        vlo:DocumentType ;
    skos:definition "Document type of normative resolutions."@en ;
    skos:inScheme vlo:DocumentTypeScheme ;
    skos:notation "NQ" ;
    skos:prefLabel "Resolution"@en,
        "Nghị quyết"@vi ;
    skos:topConceptOf vlo:DocumentTypeScheme .

