vlo:LegalNewsArticle a owl:Class ;
    rdfs:label "Legal news article"@en,
        "Bài viết tin tức pháp luật"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf schema:NewsArticle ;
    skos:definition "A news, policy or advice article about law published by a legal information portal; the knowledge graph keeps its identifier, link, date, category and the legal documents it mentions."@en,
        "Bài viết tin tức, chính sách hoặc tư vấn về pháp luật trên cổng thông tin pháp luật; đồ thị lưu mã, liên kết, ngày, chuyên mục và các văn bản được nhắc đến."@vi ;
    vlo:module vlo:module-news .

vlo:PublicAuthority a owl:Class ;
    rdfs:label "Public authority"@en,
        "Cơ quan nhà nước"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf org:Organization ;
    skos:definition "A state organisation or office holder acting for the State, such as the National Assembly, the Government, a ministry, the Prime Minister or a court."@en,
        "Tổ chức hoặc chức danh nhà nước, như Quốc hội, Chính phủ, bộ, Thủ tướng Chính phủ hoặc Tòa án."@vi ;
    vlo:module vlo:module-agents .

vlo:cites a owl:ObjectProperty ;
    rdfs:label "cites"@en,
        "trích dẫn"@vi ;
    rdfs:domain eli:LegalResource ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range eli:LegalResource ;
    rdfs:subPropertyOf eli:cites,
        vlo:refersTo ;
    skos:definition "A legal document, or one of its articles, cites another legal document or a provision of it. Self-references and anaphoric references are not included."@en ;
    vlo:module vlo:module-citation-basis .

vlo:citesCase a owl:ObjectProperty ;
    rdfs:label "cites case"@en,
        "viện dẫn bản án"@vi ;
    rdfs:domain vlo:JudicialDocument ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range vlo:JudicialDocument ;
    rdfs:subPropertyOf vlo:refersTo ;
    skos:definition "A court decision refers to another court decision (for example the first-instance judgment under appeal) or to a precedent."@en ;
    vlo:module vlo:module-judiciary .

vlo:method-law-name-year a owl:NamedIndividual,
        vlo:ExtractionMethod ;
    skos:definition "A code, law, ordinance or constitution cited by type and name, matched diacritic-insensitively to titles of in-scope documents; the version issued or effective in the cited year, or else the latest version in force at the citing date, is taken."@en ;
    skos:inScheme vlo:ExtractionMethodScheme ;
    skos:notation "law-name-year" ;
    skos:prefLabel "law name and year"@en,
        "tên luật và năm"@vi .

vlo:method-source-metadata a owl:NamedIndividual,
        vlo:ExtractionMethod ;
    skos:definition "Value taken from a structured field of the source dataset after cleaning (clean.py)."@en ;
    skos:inScheme vlo:ExtractionMethodScheme ;
    skos:notation "source-metadata" ;
    skos:prefLabel "source metadata"@en,
        "siêu dữ liệu nguồn"@vi .

