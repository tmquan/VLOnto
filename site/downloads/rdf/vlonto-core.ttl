vlo:Ordinance a owl:Class ;
    rdfs:label "Ordinance"@en,
        "Pháp lệnh"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf vlo:NormativeLegalDocument ;
    skos:definition "A normative document adopted by the Standing Committee of the National Assembly on matters assigned by the National Assembly."@en,
        "Văn bản quy phạm pháp luật do Ủy ban Thường vụ Quốc hội ban hành về những vấn đề được Quốc hội giao."@vi ;
    vlo:module vlo:module-documents ;
    vlo:typeConcept vlo:doctype-ordinance .

vlo:doctype-ordinance a owl:NamedIndividual,
        vlo:DocumentType ;
    skos:definition "Document type of ordinances of the National Assembly Standing Committee."@en ;
    skos:inScheme vlo:DocumentTypeScheme ;
    skos:notation "PL" ;
    skos:prefLabel "Ordinance"@en,
        "Pháp lệnh"@vi ;
    skos:topConceptOf vlo:DocumentTypeScheme .

vlo:change-replaced a owl:NamedIndividual,
        vlo:ChangeKind ;
    skos:definition "The affected document is replaced as a whole by the acting document."@en ;
    skos:inScheme vlo:ChangeKindScheme ;
    skos:notation "replaced" ;
    skos:prefLabel "replaced"@en,
        "thay thế"@vi ;
    skos:topConceptOf vlo:ChangeKindScheme ;
    vlo:shortcutProperty vlo:replaces .

vlo:validity-expired a owl:NamedIndividual,
        vlo:ValidityStatus ;
    skos:definition "The source status says the document is no longer in force."@en ;
    skos:inScheme vlo:ValidityStatusScheme ;
    skos:notation "expired" ;
    skos:prefLabel "no longer in force"@en,
        "hết hiệu lực"@vi ;
    skos:topConceptOf vlo:ValidityStatusScheme .

vlo:validity-in-force a owl:NamedIndividual,
        vlo:ValidityStatus ;
    skos:definition "The source status says the document is in force and no amending act was extracted."@en ;
    skos:inScheme vlo:ValidityStatusScheme ;
    skos:notation "in_force" ;
    skos:prefLabel "in force"@en,
        "còn hiệu lực"@vi ;
    skos:topConceptOf vlo:ValidityStatusScheme .

vlo:change-amended a owl:NamedIndividual,
        vlo:ChangeKind ;
    skos:definition "Some provisions of the affected document are amended or supplemented."@en ;
    skos:inScheme vlo:ChangeKindScheme ;
    skos:notation "amended" ;
    skos:prefLabel "amended"@en,
        "sửa đổi, bổ sung"@vi ;
    skos:topConceptOf vlo:ChangeKindScheme ;
    vlo:shortcutProperty vlo:amends .

