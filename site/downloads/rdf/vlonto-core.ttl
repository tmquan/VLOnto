<https://tmquan.github.io/VLOnto/ontology> a owl:Ontology ;
    dcterms:created "2026-11-11"^^xsd:date ;
    dcterms:creator [ a schema:Person ;
            schema:name "tmquan" ;
            schema:url "https://github.com/tmquan"^^xsd:anyURI ] ;
    dcterms:description "VLOnto describes Vietnamese legal documents and their provisions, the bodies that issue them, their validity and the dated events that replace, amend or repeal them, legal-basis and citation links, court decisions and case-law precedents, legal questions and answers, legal terminology, legal news and the classification schemes used to organise them. Terms are aligned with ELI (European Legislation Identifier), SKOS, DCTERMS, PROV-O, schema.org and the W3C Organization ontology by sub-class and sub-property axioms. The VLOnto knowledge graph instantiates the ontology from six public datasets of Vietnamese legal material."@en,
        "VLOnto mô tả văn bản pháp luật Việt Nam và các điều, khoản của chúng, cơ quan ban hành, tình trạng hiệu lực và các sự kiện thay thế, sửa đổi, bãi bỏ văn bản, quan hệ căn cứ pháp lý và trích dẫn, bản án, quyết định của Tòa án và án lệ, hỏi đáp pháp luật, thuật ngữ pháp lý, tin tức pháp luật và các hệ thống phân loại. Các khái niệm được liên kết với ELI, SKOS, DCTERMS, PROV-O, schema.org và W3C Organization bằng tiên đề lớp con và thuộc tính con. Đồ thị tri thức VLOnto được xây dựng từ sáu bộ dữ liệu công khai về pháp luật Việt Nam."@vi ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-11-12"^^xsd:date ;
    dcterms:rights "CC BY 4.0. Not an official legal text and not legal advice."@en ;
    dcterms:source <https://huggingface.co/datasets/tmquan/anle-toaan-gov-vn>,
        <https://huggingface.co/datasets/tmquan/cbba-toaan-gov-vn>,
        <https://huggingface.co/datasets/tmquan/thuvienphapluat-vn-hdpl>,
        <https://huggingface.co/datasets/tmquan/thuvienphapluat-vn-htpl>,
        <https://huggingface.co/datasets/tmquan/thuvienphapluat-vn-tnpl>,
        <https://huggingface.co/datasets/tmquan/thuvienphapluat-vn-vbpl> ;
    dcterms:title "VLOnto: Vietnamese Legal Ontology"@en,
        "VLOnto: Bản thể học pháp luật Việt Nam"@vi ;
    vann:preferredNamespacePrefix "vlo" ;
    vann:preferredNamespaceUri "https://tmquan.github.io/VLOnto/ontology#" ;
    rdfs:seeAlso <https://arxiv.org/abs/2611.11426>,
        <https://github.com/tmquan/VLOnto>,
        <https://tmquan.github.io/VLOnto/> ;
    owl:versionIRI <https://tmquan.github.io/VLOnto/ontology/0.1.0> ;
    owl:versionInfo "0.1.0" .

