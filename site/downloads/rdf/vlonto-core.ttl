vlo:EdgeSet a owl:Class ;
    rdfs:label "Edge set"@en,
        "Tập liên kết"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "The set of all knowledge-graph links of one property produced from one source, described with its size, the extraction methods used and the build that generated it. Per-link methods are kept in the parquet edge tables."@en,
        "Tập tất cả liên kết của một thuộc tính được tạo từ một nguồn, mô tả bằng số lượng, phương pháp trích xuất và lần xây dựng tạo ra nó."@vi ;
    vlo:module vlo:module-provenance .

vlo:LegalForceRankScheme a skos:ConceptScheme ;
    rdfs:label "Legal-force ranks"@en,
        "Thứ bậc hiệu lực pháp lý"@vi ;
    skos:definition "Six levels of legal force used by the validity rules (rule 5) and as the vertical layer of the 3D legal network."@en ;
    vlo:module vlo:module-classification .

vlo:Module a owl:Class ;
    rdfs:label "Module"@en,
        "Mô-đun bản thể"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A thematic group of VLOnto terms, such as documents, provisions or judiciary."@en,
        "Một nhóm chủ đề của các khái niệm VLOnto, ví dụ văn bản, điều khoản hay tư pháp."@vi ;
    vlo:module vlo:module-provenance .

vlo:module-classification a owl:NamedIndividual,
        vlo:Module ;
    skos:definition "Concept schemes for legal areas, document types and legal-force ranks."@en ;
    skos:inScheme vlo:ModuleScheme ;
    skos:notation "classification" ;
    skos:prefLabel "classification"@en,
        "phân loại"@vi ;
    skos:topConceptOf vlo:ModuleScheme .

skos:ConceptScheme a owl:Class ;
    rdfs:label "Concept scheme (SKOS)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .

