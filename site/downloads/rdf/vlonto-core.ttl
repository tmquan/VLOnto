vlissuer:ubnd a vlo:IssuingBody ;
    rdfs:label "People's Committee"@en,
        "Ủy ban nhân dân"@vi ;
    vlo:issuerCode "UBND" .

vlo:Appendix a owl:Class ;
    rdfs:label "Appendix"@en,
        "Phụ lục"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf vlo:Provision ;
    skos:definition "An attachment issued with a legal document, such as a regulation, charter or list promulgated by the document; it may contain its own articles."@en,
        "Văn bản kèm theo (quy định, quy chế, điều lệ, danh mục) được ban hành kèm theo văn bản; có thể có các điều riêng."@vi ;
    vlo:module vlo:module-provisions .

vlo:Article a owl:Class ;
    rdfs:label "Article"@en,
        "Điều"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf vlo:Provision ;
    skos:definition "The basic numbered unit of a legal document (Điều N), usually with a heading, divided into clauses."@en,
        "Đơn vị cơ bản được đánh số của văn bản (Điều N), thường có tên điều và gồm các khoản."@vi ;
    vlo:module vlo:module-provisions .

vlo:Chapter a owl:Class ;
    rdfs:label "Chapter"@en,
        "Chương"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf vlo:Provision ;
    skos:definition "A division of a legal document grouping sections or articles under a heading (Chương I, Chương II, ...)."@en,
        "Đơn vị của văn bản gồm các mục hoặc điều có cùng đề mục."@vi ;
    vlo:module vlo:module-provisions .

vlo:Circular a owl:Class ;
    rdfs:label "Circular"@en,
        "Thông tư"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf vlo:NormativeLegalDocument ;
    skos:definition "A normative document issued by a minister or the head of a ministerial-level agency, the Chief Justice of the Supreme People's Court, the Prosecutor General or the State Auditor General."@en,
        "Văn bản quy phạm pháp luật do Bộ trưởng, Thủ trưởng cơ quan ngang bộ, Chánh án Tòa án nhân dân tối cao, Viện trưởng Viện kiểm sát nhân dân tối cao hoặc Tổng Kiểm toán nhà nước ban hành."@vi ;
    vlo:module vlo:module-documents ;
    vlo:typeConcept vlo:doctype-circular .

vlo:Clause a owl:Class ;
    rdfs:label "Clause"@en,
        "Khoản"@vi ;
    rdfs:comment "In the knowledge graph clauses are created only when a citation, applied-provision or answer edge refers to them."@en ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf vlo:Provision ;
    skos:definition "A numbered subdivision of an article (khoản 1, khoản 2, ...)."@en,
        "Đơn vị được đánh số trong một điều (khoản 1, khoản 2, ...)."@vi ;
    vlo:module vlo:module-provisions .

vlo:Court a owl:Class ;
    rdfs:label "Court"@en,
        "Tòa án"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf vlo:PublicAuthority ;
    skos:definition "A people's court or military court that decides cases; identified by its official name, for example Tòa án nhân dân tỉnh Cà Mau."@en,
        "Tòa án nhân dân hoặc Tòa án quân sự xét xử các vụ việc; được xác định bằng tên chính thức."@vi ;
    vlo:module vlo:module-agents .

vlo:CourtRuling a owl:Class ;
    rdfs:label "Court ruling"@en,
        "Quyết định của Tòa án"@vi ;
    rdfs:comment "In the knowledge graph a decision is a CourtRuling when its number code starts with QĐ (quyết định)."@en ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf vlo:CourtDecision ;
    skos:definition "A decision of a court other than a judgment, for example recognising the parties' agreement or suspending a case."@en,
        "Quyết định của Tòa án không phải bản án, ví dụ quyết định công nhận sự thỏa thuận của các đương sự hoặc đình chỉ giải quyết vụ án."@vi ;
    vlo:module vlo:module-judiciary .

vlo:Decision a owl:Class ;
    rdfs:label "Decision"@en,
        "Quyết định"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf vlo:NormativeLegalDocument ;
    skos:definition "A normative decision issued by the Prime Minister, a minister or another competent head of a central body; only decisions numbered in the normative form N/YYYY/CODE are in scope."@en,
        "Quyết định quy phạm pháp luật của Thủ tướng Chính phủ, Bộ trưởng hoặc người đứng đầu cơ quan trung ương có thẩm quyền; chỉ các quyết định có số dạng N/YYYY/KÝ-HIỆU thuộc phạm vi."@vi ;
    vlo:module vlo:module-documents ;
    vlo:typeConcept vlo:doctype-decision .

vlo:Decree a owl:Class ;
    rdfs:label "Decree"@en,
        "Nghị định"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf vlo:NormativeLegalDocument ;
    skos:definition "A normative document issued by the Government, usually detailing or implementing laws."@en,
        "Văn bản quy phạm pháp luật do Chính phủ ban hành, thường quy định chi tiết hoặc hướng dẫn thi hành luật."@vi ;
    vlo:module vlo:module-documents ;
    vlo:typeConcept vlo:doctype-decree .

vlo:JointCircular a owl:Class ;
    rdfs:label "Joint circular"@en,
        "Thông tư liên tịch"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf vlo:NormativeLegalDocument ;
    skos:definition "A circular issued jointly by two or more ministers, heads of ministerial-level agencies or judicial bodies."@en,
        "Thông tư do hai hay nhiều Bộ trưởng, Thủ trưởng cơ quan ngang bộ hoặc cơ quan tư pháp cùng ban hành."@vi ;
    vlo:module vlo:module-documents ;
    vlo:typeConcept vlo:doctype-joint-circular .

vlo:JointResolution a owl:Class ;
    rdfs:label "Joint resolution"@en,
        "Nghị quyết liên tịch"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf vlo:NormativeLegalDocument ;
    skos:definition "A resolution issued jointly by a state body and the central body of a socio-political organisation, for example the Standing Committee of the National Assembly or the Government together with the Presidium of the Viet Nam Fatherland Front."@en,
        "Nghị quyết do cơ quan nhà nước và cơ quan trung ương của tổ chức chính trị - xã hội cùng ban hành."@vi ;
    vlo:module vlo:module-documents ;
    vlo:typeConcept vlo:doctype-joint-resolution .

vlo:LegalQuestion a owl:Class ;
    rdfs:label "Legal question"@en,
        "Câu hỏi pháp luật"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf schema:Question ;
    owl:disjointWith vlo:LegalAnswer ;
    skos:definition "A published legal question from a legal Q&A service. The knowledge graph keeps its identifier, link, date and legal area, not its text."@en,
        "Câu hỏi pháp luật được đăng trên dịch vụ hỏi đáp pháp luật. Đồ thị chỉ lưu mã, liên kết, ngày và lĩnh vực, không lưu nội dung."@vi ;
    vlo:module vlo:module-qa .

vlo:NewsCategory a owl:Class ;
    rdfs:label "News category"@en,
        "Chuyên mục tin tức"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A section of a legal news portal, such as new policies or real estate."@en,
        "Chuyên mục của cổng tin tức pháp luật, như chính sách mới hay bất động sản."@vi ;
    vlo:module vlo:module-news .

vlo:Part a owl:Class ;
    rdfs:label "Part"@en,
        "Phần"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf vlo:Provision ;
    skos:definition "A top-level division of a long legal document, grouping chapters (Phần thứ nhất, Phần thứ hai, ...)."@en,
        "Đơn vị lớn nhất trong văn bản dài, gồm nhiều chương."@vi ;
    vlo:module vlo:module-provisions .

vlo:Point a owl:Class ;
    rdfs:label "Point"@en,
        "Điểm"@vi ;
    rdfs:comment "In the knowledge graph points are created only when a citation, applied-provision or answer edge refers to them."@en ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf vlo:Provision ;
    skos:definition "A lettered subdivision of a clause (điểm a, điểm b, ...)."@en,
        "Đơn vị được đánh chữ cái trong một khoản (điểm a, điểm b, ...)."@vi ;
    vlo:module vlo:module-provisions .

vlo:Section a owl:Class ;
    rdfs:label "Section"@en,
        "Mục"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf vlo:Provision ;
    skos:definition "A division of a chapter grouping articles (Mục 1, Mục 2, ...)."@en,
        "Đơn vị của chương, gồm các điều."@vi ;
    vlo:module vlo:module-provisions .

vlo:amendedBy a owl:ObjectProperty ;
    rdfs:label "amended by"@en,
        "được sửa đổi, bổ sung bởi"@vi ;
    rdfs:domain vlo:LegalDocument ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range vlo:LegalDocument ;
    skos:definition "Inverse of vlo:amends. Not materialised in the RDF dumps."@en ;
    vlo:module vlo:module-validity-change .

vlo:amends a owl:ObjectProperty ;
    rdfs:label "amends"@en,
        "sửa đổi, bổ sung"@vi ;
    rdfs:domain vlo:LegalDocument ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range vlo:LegalDocument ;
    rdfs:subPropertyOf eli:amends,
        vlo:changes ;
    owl:inverseOf vlo:amendedBy ;
    skos:definition "The subject document amends or supplements some provisions of the object document (sửa đổi, bổ sung)."@en ;
    vlo:module vlo:module-validity-change .

vlo:answerCitesDocument a owl:ObjectProperty ;
    rdfs:label "answer cites document"@en,
        "câu trả lời trích dẫn văn bản"@vi ;
    rdfs:domain vlo:LegalAnswer ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range vlo:LegalDocument ;
    rdfs:subPropertyOf schema:citation,
        vlo:refersTo ;
    skos:definition "A legal answer cites a legal document by its number."@en ;
    vlo:module vlo:module-qa .

vlo:answerCitesProvision a owl:ObjectProperty ;
    rdfs:label "answer cites provision"@en,
        "câu trả lời trích dẫn điều khoản"@vi ;
    rdfs:domain vlo:LegalAnswer ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range vlo:Provision ;
    rdfs:subPropertyOf schema:citation,
        vlo:refersTo ;
    skos:definition "A legal answer cites an article, clause or point of a legal document."@en ;
    vlo:module vlo:module-qa .

vlo:appliesProvision a owl:ObjectProperty ;
    rdfs:label "applies provision"@en,
        "áp dụng điều khoản"@vi ;
    rdfs:domain vlo:JudicialDocument ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range vlo:Provision ;
    rdfs:subPropertyOf vlo:refersTo ;
    skos:definition "A court decision cites an article, clause or point of a legal document as applied or relied on."@en ;
    vlo:module vlo:module-judiciary .

vlo:changedBy a owl:ObjectProperty ;
    rdfs:label "changed by"@en,
        "bị thay đổi bởi"@vi ;
    rdfs:domain vlo:LegalDocument ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range vlo:LegalDocument ;
    skos:definition "Inverse of vlo:changes. Not materialised in the RDF dumps."@en ;
    vlo:module vlo:module-validity-change .

vlo:doctype-circular a owl:NamedIndividual,
        vlo:DocumentType ;
    skos:definition "Document type of circulars."@en ;
    skos:inScheme vlo:DocumentTypeScheme ;
    skos:notation "TT" ;
    skos:prefLabel "Circular"@en,
        "Thông tư"@vi ;
    skos:topConceptOf vlo:DocumentTypeScheme .

vlo:doctype-decision a owl:NamedIndividual,
        vlo:DocumentType ;
    skos:definition "Document type of normative decisions."@en ;
    skos:inScheme vlo:DocumentTypeScheme ;
    skos:notation "QĐ" ;
    skos:prefLabel "Decision"@en,
        "Quyết định"@vi ;
    skos:topConceptOf vlo:DocumentTypeScheme .

vlo:doctype-decree a owl:NamedIndividual,
        vlo:DocumentType ;
    skos:definition "Document type of Government decrees."@en ;
    skos:inScheme vlo:DocumentTypeScheme ;
    skos:notation "NĐ" ;
    skos:prefLabel "Decree"@en,
        "Nghị định"@vi ;
    skos:topConceptOf vlo:DocumentTypeScheme .

vlo:doctype-joint-circular a owl:NamedIndividual,
        vlo:DocumentType ;
    skos:definition "Document type of joint circulars."@en ;
    skos:inScheme vlo:DocumentTypeScheme ;
    skos:notation "TTLT" ;
    skos:prefLabel "Joint circular"@en,
        "Thông tư liên tịch"@vi ;
    skos:topConceptOf vlo:DocumentTypeScheme .

vlo:doctype-joint-resolution a owl:NamedIndividual,
        vlo:DocumentType ;
    skos:definition "Document type of joint resolutions."@en ;
    skos:inScheme vlo:DocumentTypeScheme ;
    skos:notation "NQLT" ;
    skos:prefLabel "Joint resolution"@en,
        "Nghị quyết liên tịch"@vi ;
    skos:topConceptOf vlo:DocumentTypeScheme .

vlo:hasPart a owl:ObjectProperty ;
    rdfs:label "has part"@en,
        "gồm"@vi ;
    rdfs:domain eli:LegalResource ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range vlo:Provision ;
    rdfs:subPropertyOf eli:has_part ;
    skos:definition "Inverse of vlo:isPartOf: links a document or provision to a provision it immediately contains. Not materialised in the RDF dumps."@en ;
    vlo:module vlo:module-provisions .

vlo:isLegalBasisOf a owl:ObjectProperty ;
    rdfs:label "is legal basis of"@en,
        "là căn cứ của"@vi ;
    rdfs:domain vlo:LegalDocument ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range vlo:LegalDocument ;
    skos:definition "Inverse of vlo:legalBasis. Not materialised in the RDF dumps."@en ;
    vlo:module vlo:module-citation-basis .

vlo:legalBasis a owl:ObjectProperty ;
    rdfs:label "legal basis"@en,
        "căn cứ pháp lý"@vi ;
    rdfs:domain vlo:LegalDocument ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range vlo:LegalDocument ;
    rdfs:subPropertyOf eli:based_on,
        vlo:refersTo ;
    owl:inverseOf vlo:isLegalBasisOf ;
    skos:definition "The object document is a legal basis on which the subject document was issued, as listed in the 'Căn cứ ...' recitals of its preamble or in the source's parent-acts field. The object never has a lower legal-force rank than the subject."@en ;
    vlo:module vlo:module-citation-basis .

vlo:mentionsDocument a owl:ObjectProperty ;
    rdfs:label "mentions document"@en,
        "nhắc đến văn bản"@vi ;
    rdfs:domain vlo:LegalNewsArticle ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range vlo:LegalDocument ;
    rdfs:subPropertyOf schema:mentions,
        vlo:refersTo ;
    skos:definition "A news article mentions a legal document by its number."@en ;
    vlo:module vlo:module-news .

vlo:method-answer-text-name a owl:NamedIndividual,
        vlo:ExtractionMethod ;
    skos:definition "The document is read from the answer text right after 'Điều N' and matched by law name and year."@en ;
    skos:inScheme vlo:ExtractionMethodScheme ;
    skos:notation "answer-text-name" ;
    skos:prefLabel "answer text, name"@en,
        "nội dung trả lời, tên luật"@vi .

vlo:method-answer-text-number a owl:NamedIndividual,
        vlo:ExtractionMethod ;
    skos:definition "The document is read from the answer text right after 'Điều N' and matched by its number."@en ;
    skos:inScheme vlo:ExtractionMethodScheme ;
    skos:notation "answer-text-number" ;
    skos:prefLabel "answer text, number"@en,
        "nội dung trả lời, số văn bản"@vi .

vlo:method-case-number-court a owl:NamedIndividual,
        vlo:ExtractionMethod ;
    skos:definition "A cited decision is matched by number, year, symbol and the court named next to the citation."@en ;
    skos:inScheme vlo:ExtractionMethodScheme ;
    skos:notation "case-number-court" ;
    skos:prefLabel "case number and court"@en,
        "số bản án và Tòa án"@vi .

vlo:method-case-number-date a owl:NamedIndividual,
        vlo:ExtractionMethod ;
    skos:definition "A cited decision is matched by number, year, symbol and the exact date written next to the citation; the court named next to the citation, when present, must also match. Without a named court the match is kept only when the courts of both decisions are known and are the same court, lie in the same province, or the citing court is the Supreme Court or the High Court of the cited court's region."@en ;
    skos:inScheme vlo:ExtractionMethodScheme ;
    skos:notation "case-number-date" ;
    skos:prefLabel "case number and date"@en,
        "số và ngày bản án"@vi .

vlo:method-citation-field-name a owl:NamedIndividual,
        vlo:ExtractionMethod ;
    skos:definition "The document is matched from the law-name and year fields of the source citation."@en ;
    skos:inScheme vlo:ExtractionMethodScheme ;
    skos:notation "citation-field-name" ;
    skos:prefLabel "citation field, name"@en,
        "trường trích dẫn, tên luật"@vi .

vlo:method-constitution-preamble a owl:NamedIndividual,
        vlo:ExtractionMethod ;
    skos:definition "Legal basis on the Constitution, which has no number and therefore no citation record: 'Căn cứ Hiến pháp ...' before Article 1 is linked to the constitution named by year or by its amending resolution, otherwise to the one in force on the citing document's issue date."@en ;
    skos:inScheme vlo:ExtractionMethodScheme ;
    skos:notation "constitution-preamble" ;
    skos:prefLabel "Constitution in the preamble"@en,
        "Hiến pháp trong phần căn cứ"@vi .

vlo:method-docnum-regex a owl:NamedIndividual,
        vlo:ExtractionMethod ;
    skos:definition "Document numbers of the form N/YYYY/CODE found by regular expression in a text and resolved by docnum_key."@en ;
    skos:inScheme vlo:ExtractionMethodScheme ;
    skos:notation "docnum-regex" ;
    skos:prefLabel "document-number pattern"@en,
        "mẫu số văn bản"@vi .

vlo:method-parent-acts a owl:NamedIndividual,
        vlo:ExtractionMethod ;
    skos:definition "Legal basis taken from the parent_acts field of the vbpl dataset and resolved by number or name."@en ;
    skos:inScheme vlo:ExtractionMethodScheme ;
    skos:notation "parent-acts" ;
    skos:prefLabel "parent-acts field"@en,
        "trường văn bản căn cứ"@vi .

vlo:method-preamble-citation a owl:NamedIndividual,
        vlo:ExtractionMethod ;
    skos:definition "Legal basis taken from citations that the vbpl dataset locates in the preamble of the citing document, kept only when the cited document does not have a lower legal-force rank than the citing one."@en ;
    skos:inScheme vlo:ExtractionMethodScheme ;
    skos:notation "preamble-citation" ;
    skos:prefLabel "preamble citation"@en,
        "trích dẫn phần căn cứ"@vi .

vlo:method-precedent-number a owl:NamedIndividual,
        vlo:ExtractionMethod ;
    skos:definition "A precedent cited by its national number NN/YYYY/AL."@en ;
    skos:inScheme vlo:ExtractionMethodScheme ;
    skos:notation "precedent-number" ;
    skos:prefLabel "precedent number"@en,
        "số án lệ"@vi .

vlo:method-unique-document-of-type a owl:NamedIndividual,
        vlo:ExtractionMethod ;
    skos:definition "A provision cited without a law name is attached to the only document of that type cited in the same record."@en ;
    skos:inScheme vlo:ExtractionMethodScheme ;
    skos:notation "unique-document-of-type" ;
    skos:prefLabel "unique document of type"@en,
        "văn bản duy nhất cùng loại"@vi .

vlo:partiallyRepealedBy a owl:ObjectProperty ;
    rdfs:label "partially repealed by"@en,
        "bị bãi bỏ một phần bởi"@vi ;
    rdfs:domain vlo:LegalDocument ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range vlo:LegalDocument ;
    skos:definition "Inverse of vlo:partiallyRepeals. Not materialised in the RDF dumps."@en ;
    vlo:module vlo:module-validity-change .

vlo:partiallyRepeals a owl:ObjectProperty ;
    rdfs:label "partially repeals"@en,
        "bãi bỏ một phần"@vi ;
    rdfs:domain vlo:LegalDocument ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range vlo:LegalDocument ;
    rdfs:subPropertyOf vlo:changes ;
    owl:inverseOf vlo:partiallyRepealedBy ;
    skos:definition "The subject document repeals some articles, clauses, points or contents of the object document, which otherwise stays in force."@en ;
    vlo:module vlo:module-validity-change .

vlo:partiallyTerminatedBy a owl:ObjectProperty ;
    rdfs:label "partially terminated by"@en,
        "bị làm hết hiệu lực một phần bởi"@vi ;
    rdfs:domain vlo:LegalDocument ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range vlo:LegalDocument ;
    skos:definition "Inverse of vlo:partiallyTerminates. Not materialised in the RDF dumps."@en ;
    vlo:module vlo:module-validity-change .

vlo:partiallyTerminates a owl:ObjectProperty ;
    rdfs:label "partially terminates"@en,
        "làm hết hiệu lực một phần"@vi ;
    rdfs:domain vlo:LegalDocument ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range vlo:LegalDocument ;
    rdfs:subPropertyOf vlo:changes ;
    owl:inverseOf vlo:partiallyTerminatedBy ;
    skos:definition "The subject document declares that some provisions of the object document cease to be in force (hết hiệu lực một phần)."@en ;
    vlo:module vlo:module-validity-change .

vlo:relatedTerm a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "related term"@en,
        "thuật ngữ liên quan"@vi ;
    rdfs:domain vlo:LegalTerm ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range vlo:LegalTerm ;
    rdfs:subPropertyOf skos:related ;
    skos:definition "A legal term listed by the source as related to another term."@en ;
    vlo:module vlo:module-terminology .

vlo:repealedBy a owl:ObjectProperty ;
    rdfs:label "repealed by"@en,
        "bị bãi bỏ bởi"@vi ;
    rdfs:domain vlo:LegalDocument ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range vlo:LegalDocument ;
    skos:definition "Inverse of vlo:repeals. Not materialised in the RDF dumps."@en ;
    vlo:module vlo:module-validity-change .

vlo:repeals a owl:ObjectProperty ;
    rdfs:label "repeals"@en,
        "bãi bỏ"@vi ;
    rdfs:domain vlo:LegalDocument ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range vlo:LegalDocument ;
    rdfs:subPropertyOf eli:repeals,
        vlo:changes ;
    owl:inverseOf vlo:repealedBy ;
    skos:definition "The subject document repeals the object document as a whole without replacing it (bãi bỏ)."@en ;
    vlo:module vlo:module-validity-change .

vlo:replacedBy a owl:ObjectProperty ;
    rdfs:label "replaced by"@en,
        "được thay thế bởi"@vi ;
    rdfs:domain vlo:LegalDocument ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range vlo:LegalDocument ;
    skos:definition "Inverse of vlo:replaces. Not materialised in the RDF dumps."@en ;
    vlo:module vlo:module-validity-change .

vlo:replaces a owl:ObjectProperty ;
    rdfs:label "replaces"@en,
        "thay thế"@vi ;
    rdfs:domain vlo:LegalDocument ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range vlo:LegalDocument ;
    rdfs:subPropertyOf eli:repeals,
        vlo:changes ;
    owl:inverseOf vlo:replacedBy ;
    skos:definition "The subject document replaces the object document as a whole, which then ceases to be in force (thay thế)."@en ;
    vlo:module vlo:module-validity-change .

vlo:selectedFrom a owl:ObjectProperty ;
    rdfs:label "selected from"@en,
        "được lựa chọn từ"@vi ;
    rdfs:domain vlo:Precedent ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range vlo:CourtDecision ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    skos:definition "The court decision whose reasoning or ruling was selected as the precedent."@en ;
    vlo:module vlo:module-judiciary .

eli:is_part_of a owl:ObjectProperty ;
    rdfs:label "is part of (ELI)"@en ;
    rdfs:isDefinedBy <http://data.europa.eu/eli/ontology> .

eli:repeals a owl:ObjectProperty ;
    rdfs:label "repeals (ELI)"@en ;
    rdfs:isDefinedBy <http://data.europa.eu/eli/ontology> .

dcterms:title a owl:DatatypeProperty ;
    rdfs:label "title (DCTERMS)"@en ;
    rdfs:isDefinedBy dcterms: .

prov:Activity a owl:Class ;
    rdfs:label "Activity (PROV)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> .

prov:Entity a owl:Class ;
    rdfs:label "Entity (PROV)"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> .

schema:citation a owl:ObjectProperty ;
    rdfs:label "citation (schema.org)"@en ;
    rdfs:isDefinedBy schema: .

