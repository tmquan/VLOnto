vlo:ChangeKind a owl:Class ;
    rdfs:label "Change kind"@en,
        "Loại thay đổi"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A kind of legal change: replaced, amended, repealed, partially repealed or partially terminated."@en,
        "Loại thay đổi: thay thế, sửa đổi bổ sung, bãi bỏ, bãi bỏ một phần, hết hiệu lực một phần."@vi ;
    vlo:module vlo:module-validity-change .

vlo:Constitution a owl:Class ;
    rdfs:label "Constitution"@en,
        "Hiến pháp"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf vlo:NormativeLegalDocument ;
    skos:definition "The fundamental law of the State, adopted by the National Assembly; it has the highest legal force."@en,
        "Đạo luật cơ bản của Nhà nước do Quốc hội thông qua, có hiệu lực pháp lý cao nhất."@vi ;
    vlo:module vlo:module-documents ;
    vlo:typeConcept vlo:doctype-constitution .

vlo:CourtLevel a owl:Class ;
    rdfs:label "Court level"@en,
        "Cấp Tòa án"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "The level of a court in the court system: supreme, high, provincial, district or military."@en,
        "Cấp của Tòa án trong hệ thống: tối cao, cấp cao, cấp tỉnh, cấp huyện hoặc quân sự."@vi ;
    vlo:module vlo:module-judiciary .

vlo:changes a owl:ObjectProperty ;
    rdfs:label "changes"@en,
        "thay đổi"@vi ;
    rdfs:domain vlo:LegalDocument ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:range vlo:LegalDocument ;
    rdfs:subPropertyOf eli:changes ;
    owl:inverseOf vlo:changedBy ;
    skos:definition "Shortcut for any legal change: the subject document replaces, amends, repeals, partially repeals or partially terminates the object document."@en ;
    vlo:module vlo:module-validity-change .

vlo:doctype-constitution a owl:NamedIndividual,
        vlo:DocumentType ;
    skos:definition "Document type of the Constitution."@en ;
    skos:inScheme vlo:DocumentTypeScheme ;
    skos:notation "HP" ;
    skos:prefLabel "Constitution"@en,
        "Hiến pháp"@vi ;
    skos:topConceptOf vlo:DocumentTypeScheme .

vlo:module-agents a owl:NamedIndividual,
        vlo:Module ;
    skos:definition "Public authorities that issue documents or decide cases."@en ;
    skos:inScheme vlo:ModuleScheme ;
    skos:notation "agents" ;
    skos:prefLabel "agents"@en,
        "chủ thể"@vi ;
    skos:topConceptOf vlo:ModuleScheme .

vlo:module-citation-basis a owl:NamedIndividual,
        vlo:Module ;
    skos:definition "Legal-basis and citation links between legal resources and from other works to legal resources."@en ;
    skos:inScheme vlo:ModuleScheme ;
    skos:notation "citation-basis" ;
    skos:prefLabel "citation and legal basis"@en,
        "trích dẫn và căn cứ"@vi ;
    skos:topConceptOf vlo:ModuleScheme .

vlo:module-news a owl:NamedIndividual,
        vlo:Module ;
    skos:definition "Legal news and policy articles that mention legal documents."@en ;
    skos:inScheme vlo:ModuleScheme ;
    skos:notation "news" ;
    skos:prefLabel "news"@en,
        "tin tức"@vi ;
    skos:topConceptOf vlo:ModuleScheme .

vlo:module-terminology a owl:NamedIndividual,
        vlo:Module ;
    skos:definition "Legal terms organised as SKOS concepts."@en ;
    skos:inScheme vlo:ModuleScheme ;
    skos:notation "terminology" ;
    skos:prefLabel "terminology"@en,
        "thuật ngữ"@vi ;
    skos:topConceptOf vlo:ModuleScheme .

eli:LegalResource a owl:Class ;
    rdfs:label "Legal resource (ELI)"@en ;
    rdfs:isDefinedBy <http://data.europa.eu/eli/ontology> .

