vlo:method-validity-rules-v7 a owl:NamedIndividual,
        vlo:ExtractionMethod ;
    skos:definition "Replace, amend, repeal and termination relations extracted from operative clauses of the acting document (validity.py rules v7: operative-clause and description filters, date-matched year-less numbers, partial subjects, legal-hierarchy filter, status-first precedence); manual precision 29/30 on a sample."@en ;
    skos:inScheme vlo:ExtractionMethodScheme ;
    skos:notation "validity-rules-v7" ;
    skos:prefLabel "validity rules v7"@en,
        "bộ luật hiệu lực v7"@vi .

vlo:LegalChange a owl:Class ;
    rdfs:label "Legal change"@en,
        "Sự kiện thay đổi hiệu lực văn bản"@vi ;
    rdfs:isDefinedBy <https://tmquan.github.io/VLOnto/ontology> ;
    rdfs:subClassOf prov:Activity ;
    skos:definition "A dated event in which an acting legal document replaces, amends, repeals, partially repeals or partially terminates an affected legal document. The event is reified so that its kind, effective date, the evidence sentence and the extraction method can be recorded; the direct shortcut properties (vlo:replaces, vlo:amends, ...) carry the same information without the details."@en,
        "Sự kiện có ngày hiệu lực, trong đó một văn bản thay thế, sửa đổi bổ sung, bãi bỏ, bãi bỏ một phần hoặc làm hết hiệu lực một phần văn bản khác; được biểu diễn thành nút để ghi loại thay đổi, ngày hiệu lực, câu chứng cứ và phương pháp trích xuất."@vi ;
    vlo:module vlo:module-validity-change .

