vldocume:11452 a vlo:Ordinance ;
    rdfs:label "Pháp lệnh sửa đổi, bổ sung một số điều của Pháp lệnh Thủ tục giải quyết các vụ án hành chính (29/2006/PL-UBTVQH11)"@vi ;
